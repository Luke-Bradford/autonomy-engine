node_modules/
# pnpm's content store — pinned here via `storeDir` in pnpm-workspace.yaml so a
# cross-volume runner never leaks a stray `.pnpm-store/` into the parent repo.
.pnpm-store/
dist/
*.local
.env
.env.*
*.sqlite
*.sqlite-*
data/
.DS_Store
.scaffold-report.md
.spike-report.md
# Playwright (#713) run artifacts — traces/screenshots for a failed spec, and
# the HTML report. The throwaway server state the e2e run writes lives under
# `data/`, already ignored above.
test-results/
playwright-report/
blob-report/

# Build identity (#792) — written by scripts/write-manifest.mjs at build time,
# never authored by hand or committed; a dev build's version/commit/arch would
# otherwise vary machine to machine and collide across worktrees.
packages/server/manifest.json


# #1199 — `tsc -b` incremental caches. These were committed by accident
# (`3d44b5c0`, server + shared), and being tracked they dirty the working tree
# on every build, which is how the `dist/` artifacts this ticket is about
# stayed unnoticed: a `git status` that is never clean stops being read. Same
# reasoning as `manifest.json` directly above — a build-time artifact, machine
# varying, never authored by hand.
*.tsbuildinfo
