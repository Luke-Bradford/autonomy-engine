__pycache__/
*.pyc
.DS_Store
.superpowers/
.screenshots/
# pnpm content-addressed store — a build artifact (a stray one can appear at the
# repo root when pnpm is run with a root store-dir); never tracked.
.pnpm-store/

# Loop runtime artifacts written by the supervisor when autonomy-engine runs
# on ITSELF (session logs + the process lock). Anchored to the repo root so the
# committed tests/fixtures/*/var/ fixtures are NOT matched. Without this the
# supervisor's "tree clean on origin/main" preflight would stash/skip forever.
/var/autonomy-logs/
/var/autonomy-supervisor.lock/
/var/cron/
/var/events/
.claude/agents/planner.md

# Loop control-plane RUNTIME state. The scripts in loop/ are tracked; what they
# WRITE is not. logs/ alone is ~546MB of per-fire stream-json (one file per fire,
# multi-MB each), .last_quota is a per-machine cache of the last readable
# 7-day utilization reading, and .last_quota_poll is the source-2 poll throttle's
# memo (#777) -- both per-machine, both meaningless in another checkout.
# Anchored to the repo root.
/loop/logs/
/loop/.last_quota
/loop/.last_quota_poll

# Page snapshots / traces the playwright MCP server writes into its launch CWD.
# Unattended this is git-VISIBLE dirt: the supervisor's "tree clean on
# origin/main" preflight stashes it and a recovery hook can sweep it onto the
# working branch — same reason the /var/ artifacts above are ignored.
/.playwright-mcp/
