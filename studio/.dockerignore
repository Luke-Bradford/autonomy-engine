# Keep the build context small + deterministic: the image builds from source
# inside the `build` stage (pnpm install + tsc/vite), so nothing prebuilt or
# host-specific should be shipped into context.
**/node_modules
.pnpm-store
**/dist
data
.git
.gitignore
**/__tests__
**/*.test.ts
*.sqlite
*.sqlite-*
*.local
.env
.env.*
.DS_Store
Dockerfile
.dockerignore
docker-compose.yml
