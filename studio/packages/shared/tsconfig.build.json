{
  "extends": "./tsconfig.json",
  // #1199 — the EMIT project. `rootDir` + `include` are re-stated here rather
  // than inherited so the emitted layout stays `dist/index.js`: the parent now
  // also includes `vitest.config.ts`, which lies outside `src` and would both
  // break `rootDir` and shift every output path down into `dist/src/`. A
  // child's `include` REPLACES the parent's, so this is a complete override,
  // not a merge — `dist/` is byte-identical to before the #1199 restructure.
  // (Verbatim the shape #726 gave `packages/server/tsconfig.build.json`.)
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false
  },
  "include": ["src"],
  // #1199 — BOTH patterns, mirroring `packages/server/tsconfig.build.json`.
  // `*.test.ts` alone is not enough: a `__tests__/helpers/` module is test-only
  // code that no production entry point imports, and excluding only the files
  // named `*.test.ts` left it emitted into `dist/`.
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**"]
}
