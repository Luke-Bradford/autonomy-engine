{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // #1199 — `noEmit` here, `noEmit: false` in `tsconfig.build.json`. This is
    // the root-cause half of the fix: `tsc -b packages/cli` selects THIS config
    // (the one that includes tests) and, in build mode, EMITS — planting
    // compiled `*.test.js` in a gitignored `dist/` for vitest to collect as a
    // duplicate suite. With `noEmit` here that command is a harmless no-op.
    // `packages/web` has set this for the same structural reason all along.
    "noEmit": true
  },
  // #1199, following #726's precedent in `packages/server/tsconfig.json` —
  // `vitest.config.ts` is typechecked so a mistyped option in it cannot be
  // silently ignored (vitest does not error on unknown keys, so a misspelt
  // `include` would leave the guard absent and the typecheck green). `rootDir`
  // moved to `tsconfig.build.json` to allow it: a file outside `src` in a
  // project that sets `rootDir: "src"` is a hard TS6059, which `noEmit` does
  // NOT suppress (measured).
  "include": ["src", "vitest.config.ts"]
}
