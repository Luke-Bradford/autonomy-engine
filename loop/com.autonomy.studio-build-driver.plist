<?xml version="1.0" encoding="UTF-8"?>
<!--
  studio-build-loop DRIVER LaunchAgent. Runs drive.sh ONCE at load (RunAtLoad),
  KeepAlive=false so a clean stop-condition exit stays stopped (no thrash-restart).
  drive.sh internally loops run.sh (fresh headless claude per piece) until a signal
  issue / stall / cap. This is the headless continuous driver -- no interactive
  session in the loop.
  Load:   launchctl load ~/Library/LaunchAgents/com.autonomy.studio-build-driver.plist
  Stop:   launchctl unload ~/Library/LaunchAgents/com.autonomy.studio-build-driver.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.autonomy.studio-build-driver</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/lukebradford/Dev/studio-loop/drive.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/lukebradford/Dev/studio-loop-repo</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>

    <!-- DELIBERATELY NO STUDIO_QUOTA_URL. THIS COPY pinned it to 8080 (added by
         3a17fe1, the C2 PR). The pin never took effect, because this file is a
         versioned copy and the INSTALLED agent predates it and carries no pin --
         but it was a trap rather than a dead letter: an EnvironmentVariables
         entry BEATS drive.sh's `${VAR:-default}`, so the first time anyone
         copied this file over the installed one, every later change to that
         default would have gone silently inert. The port now lives in exactly
         one place, drive.sh's default (8788, the supervised service from #765
         Defect 2), and `test_install_studio_server.sh` asserts the installer
         agrees with it. Do not re-add a pin here. -->
  </dict>

  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <!-- Scheduled starts: fires drive.sh at 03:05 + 09:05 + 15:05 + 21:05 local daily.

       09:05 + 15:05 added 2026-08-05. Measured cause: the 7-day window reset at
       02:59 on 2026-08-05, 55 minutes AFTER the 02:05 tick had already read 96%
       and stopped -- so the next chance to notice was 21:05, an 18h idle gap on
       a loop that was working correctly. Four ticks bound that gap to 6h.

       THIS RELAXES THE "OUT OF WORK HOURS" PROPERTY the 21:05 note below records,
       deliberately and with a narrower claim behind it: a tick only ever STARTS a
       stopped driver, and a started driver already runs continuously for days
       (the 2026-07-31 run spanned 30h and three ticks), so the loop was never in
       fact confined to off-hours once running. What protects the operator's own
       headroom is QUOTA_STOP_PCT=80%, which is evaluated on every tick -- not the
       hour the tick lands on. A mid-day tick that finds the window busy costs one
       ~10s no-op run and zero tokens (the auth check runs AFTER the quota gate).
       If the operator wants off-hours starts back, delete these two dicts.
       03:05 set 2026-07-14 to start the ADF-grade foundation build ~13h out
       (operator near weekly token cap). 21:05 added 2026-07-23 so a stop whose
       cause clears during the day resumes the same evening instead of waiting
       for 03:05 (kept OUT of work hours -- the loop shares the operator's
       subscription quota). drive.sh loops the whole build back-to-back; a tick
       on an already-running driver is a launchd no-op (single instance per
       label), so these are harmless resume-if-stalled heartbeats.
       To disable: launchctl unload this.

       DRIFT REPAIR (#765): this copy had only the 03:05 dict while the INSTALLED
       agent has both -- the 21:05 entry was added live on 2026-07-23 and never
       backported. Copying this file over the live one would have silently
       deleted a scheduled fire. Reconciled here; diff the two before any sync. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>3</integer>
      <key>Minute</key><integer>5</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>9</integer>
      <key>Minute</key><integer>5</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>15</integer>
      <key>Minute</key><integer>5</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>21</integer>
      <key>Minute</key><integer>5</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/lukebradford/Dev/studio-loop/logs/driver.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/lukebradford/Dev/studio-loop/logs/driver.launchd.err.log</string>
</dict>
</plist>
